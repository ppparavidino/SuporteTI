# Banco de dados SQL Server
DB_SERVER=localhost\SQLEXPRESS
DB_DATABASE=SuporteTI
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_AGENTE_USER=agente_ia
DB_AGENTE_PASSWORD=change-me

# Serviço de IA local
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# E-mail SMTP (use credenciais próprias fora do repositório)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_SSL=true
SMTP_SENDER=
SMTP_SENDER_NAME=Suporte de TI

# Origens permitidas, separadas por vírgula
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Armazenamento de anexos
ANEXOS_PATH=./anexos
ANEXOS_MAX_MB=50
ANEXOS_RETENCAO_DIAS=365
ANEXOS_EXTENSOES_PERMITIDAS=jpg,jpeg,png,pdf,mp4,mov
